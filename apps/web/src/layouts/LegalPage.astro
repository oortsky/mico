---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';

interface Props {
	title: string;
	description?: string;
	date?: Date;
}

const {
	title,
	description = title,
	date
} = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
    <style>
    	main {
    		width: min(100%, 900px);
    		margin: 0 auto;
    		padding: 2rem 1rem 4rem;
    	}
    
    	.article {
    		color: rgb(var(--gray-dark));
    	}
    
    	.prose {
    		width: min(100%, 720px);
    		margin: 0 auto;
    	}
    
    	.header {
    		margin-bottom: 3rem;
    		padding-bottom: 1.5rem;
    		text-align: center;
    		border-bottom: 1px solid rgba(var(--gray), 0.2);
    	}
    
    	.header h1 {
    		margin: 0;
    		font-size: clamp(2.2rem, 5vw, 3.5rem);
    		line-height: 1.1;
    		letter-spacing: -0.03em;
    		color: rgb(var(--black));
    	}
    
    	.date {
    		margin-bottom: 1rem;
    		color: rgb(var(--gray));
    		font-size: 0.95rem;
    		letter-spacing: 0.02em;
    	}
    
    	.content {
    		font-size: 1rem;
    		line-height: 1.8;
    		color: rgb(var(--gray-dark));
    	}
    
    	.content :global(h2) {
    		margin-top: 3rem;
    		margin-bottom: 1rem;
    		font-size: 1.8rem;
    		line-height: 1.2;
    	}
    
    	.content :global(h3) {
    		margin-top: 2rem;
    		margin-bottom: 0.75rem;
    		font-size: 1.4rem;
    		line-height: 1.3;
    	}
    
    	.content :global(p) {
    		margin-bottom: 1.5rem;
    	}
    
    	.content :global(ul),
    	.content :global(ol) {
    		padding-left: 1.5rem;
    		margin-bottom: 1.5rem;
    	}
    
    	.content :global(li) {
    		margin-bottom: 0.5rem;
    	}
    
    	.content :global(a) {
    		color: rgb(var(--accent));
    		text-decoration: underline;
    		text-underline-offset: 0.15em;
    		word-break: break-word;
    	}
    
    	.content :global(img) {
    		width: 100%;
    		height: auto;
    		margin: 2rem 0;
    		border-radius: 1rem;
    	}
    
    	.content :global(blockquote) {
    		margin: 2rem 0;
    		padding-left: 1rem;
    		border-left: 3px solid rgb(var(--gray));
    		color: rgb(var(--gray));
    		font-style: italic;
    	}
    
    	.content :global(code) {
    		padding: 0.15em 0.4em;
    		border-radius: 0.35rem;
    		background: rgba(var(--gray), 0.12);
    		font-size: 0.9em;
    	}
    
    	.content :global(pre) {
    		padding: 1rem;
    		border-radius: 1rem;
    		overflow-x: auto;
    		background: rgb(var(--gray-dark));
    	}
    
    	.content :global(pre code) {
    		background: transparent;
    		padding: 0;
    		color: white;
    	}
    
    	@media (max-width: 768px) {
    		main {
    			padding: 1.5rem 1rem 3rem;
    		}
    
    		.header {
    			margin-bottom: 2rem;
    		}
    
    		.content {
    			font-size: 0.98rem;
    			line-height: 1.75;
    		}
    	}
    </style>
	</head>

	<body>
		<Header />
      <main>
      	<article class="article">
      		<div class="prose">
      			<header class="header">
      				<div class="date">
      					<FormattedDate date={date} />
      				</div>
      
      				<h1>{title}</h1>
      			</header>
      
      			<div class="content">
      				<slot />
      			</div>
      		</div>
      	</article>
      </main>
		<Footer />
	</body>
</html>